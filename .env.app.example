# Application configuration. Copy to .env.app and replace the placeholder keys.
POSTGRES_URL=postgresql://postgres:germinare@localhost:5433/assessoriadb

GEMINI_API_KEY=replace-with-gemini-key
GROQ_API_KEY=replace-with-groq-key

MONGODB_URI=mongodb://localhost:27017
MONGODB_DBNAME=assessoria

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/app.log
APP_TIMEZONE=America/Sao_Paulo
